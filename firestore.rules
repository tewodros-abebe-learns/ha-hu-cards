rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Default Security Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Primitive Helper Functions
    // ===============================================================
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Schema Validation Helpers
    // ===============================================================
    function activeOwned(data) {
      return data.ownerId == request.auth.uid && (!('deleting' in data) || data.deleting == false);
    }

    // Folder depth is capped at three; check the entire ancestor chain.
    function activeGrandparent(id) {
      return activeOwned(getAfter(/databases/$(database)/documents/folders/$(id)).data);
    }
    function activeParent(id) {
      let parent = getAfter(/databases/$(database)/documents/folders/$(id)).data;
      return activeOwned(parent) && (!('parentId' in parent) || parent.parentId == null || activeGrandparent(parent.parentId));
    }
    function ownsFolder(id) {
      let folder = getAfter(/databases/$(database)/documents/folders/$(id)).data;
      return isValidId(id) && activeOwned(folder) &&
        (!('parentId' in folder) || folder.parentId == null || activeParent(folder.parentId));
    }
    function validImage(value) {
      return value is string && value.size() <= 500000 && !value.matches('.*[\\x00-\\x20\\x7f\\\\].*') &&
        (value == '' || value.matches('^(physics_1|biology_dna|biology_heart|chemo_acid_base)_(front|back)$') ||
         value.matches('(?i)^data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/]+={0,2}$') ||
         value.matches('^/[^/].*$') || value.matches('^https?://[^/@?#]+([/?#].*)?$'));
    }

    function validParent(data, folderId) {
      return ((!('parentId' in data) || data.parentId == null) && data.level == 1) ||
        ('parentId' in data && data.parentId != null && data.parentId != folderId && ownsFolder(data.parentId) &&
         getAfter(/databases/$(database)/documents/folders/$(data.parentId)).data.level == data.level - 1);
    }

    function isValidFolder(data) {
      return data.keys().hasAll(['name', 'level', 'ownerId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.level is int && data.level >= 1 && data.level <= 3 &&
             (!('parentId' in data) || data.parentId == null || (data.parentId is string && isValidId(data.parentId))) &&
             (!('isSample' in data) || data.isSample is bool) &&
             (!('deleting' in data) || data.deleting is bool) &&
             data.ownerId == request.auth.uid;
    }

    function validReview(r) {
      return r is map && r.keys().hasOnly(['version', 'revision', 'memory', 'paused', 'group', 'introducedDay', 'reviewedDay', 'failures', 'history']) &&
        r.version == 1 && r.revision is string && r.revision.size() <= 128 &&
        r.paused is bool && r.group is string && r.group.size() <= 80 &&
        r.introducedDay is string && r.introducedDay.size() <= 10 && r.reviewedDay is string && r.reviewedDay.size() <= 10 &&
        r.failures is int && r.failures >= 0 && r.failures <= 1000000 &&
        r.history is list && r.history.size() <= 100 && validMemory(r.memory);
    }
    function validMemory(m) {
      return m is map && m.keys().hasOnly(['due','stability','difficulty','elapsed_days','scheduled_days','learning_steps','reps','lapses','state','last_review']) &&
        m.due is number && m.due >= 0 && m.due <= 8640000000000000 &&
        (m.last_review == null || (m.last_review is number && m.last_review >= 0 && m.last_review <= 8640000000000000)) &&
        m.stability is number && m.stability >= 0 && m.stability <= 100000 &&
        m.difficulty is number && m.difficulty >= 0 && m.difficulty <= 10 &&
        m.elapsed_days is number && m.elapsed_days >= 0 && m.elapsed_days <= 100000000 &&
        m.scheduled_days is number && m.scheduled_days >= 0 && m.scheduled_days <= 36500 &&
        m.learning_steps is int && m.learning_steps >= 0 && m.learning_steps <= 2 &&
        m.reps is int && m.reps >= 0 && m.reps <= 1000000 &&
        m.lapses is int && m.lapses >= 0 && m.lapses <= m.reps && m.state in [0,1,2,3] &&
        (m.state == 0 || (m.reps >= 1 && m.stability > 0 && m.difficulty >= 1 && m.last_review != null));
    }

    function isValidFlashcard(data) {
      return data.keys().hasAll(['unitId', 'ownerId']) &&
             (!('review' in data) || (validReview(data.review) && data.nextReview == data.review.memory.due)) &&
             data.unitId is string && isValidId(data.unitId) &&
             data.ownerId == request.auth.uid &&
             (!('frontText' in data) || (data.frontText is string && data.frontText.size() <= 2000)) &&
             (!('backText' in data) || (data.backText is string && data.backText.size() <= 2000)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('cardName' in data) || (data.cardName is string && data.cardName.size() <= 200)) &&
             (!('frontImageUrl' in data) || validImage(data.frontImageUrl)) &&
             (!('backImageUrl' in data) || validImage(data.backImageUrl)) &&
             (!('aspectRatio' in data) || (data.aspectRatio is number && data.aspectRatio >= 0.001 && data.aspectRatio <= 10)) &&
             (!('textSize' in data) || (data.textSize is number && data.textSize >= 8 && data.textSize <= 120)) &&
             (!('textColor' in data) || (data.textColor is string && data.textColor.size() <= 32)) &&
             (!('verticalAlign' in data) || (data.verticalAlign in ['top', 'center', 'bottom'])) &&
             (!('easeFactor' in data) || (data.easeFactor is number && data.easeFactor >= 1.0 && data.easeFactor <= 10.0)) &&
             (!('interval' in data) || (data.interval is number && data.interval >= 0 && data.interval <= 100000)) &&
             (!('nextReview' in data) || (data.nextReview is number && data.nextReview >= 0 && data.nextReview <= 9007199254740991));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /folders/{folderId} {
      allow get: if isAuthenticated() && isValidId(folderId) && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && isValidId(folderId) && isValidFolder(incoming()) && validParent(incoming(), folderId) && incoming().keys().hasOnly(['name', 'level', 'ownerId', 'parentId', 'createdAt', 'updatedAt', 'isSample']);
      allow update: if isAuthenticated() && isValidId(folderId) && isDocOwner() && incoming().ownerId == existing().ownerId && isValidFolder(incoming()) &&
        ((incoming().diff(existing()).affectedKeys().hasOnly(['deleting']) && ('deleting' in incoming()) && incoming().deleting == true) ||
         (ownsFolder(folderId) && validParent(incoming(), folderId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])));
      allow delete: if isAuthenticated() && isValidId(folderId) && isDocOwner() && existing().deleting == true;
    }

    match /flashcards/{cardId} {
      allow get: if isAuthenticated() && isValidId(cardId) && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && isValidId(cardId) && isValidFlashcard(incoming()) && ownsFolder(incoming().unitId) && incoming().keys().hasOnly(['unitId', 'ownerId', 'cardName', 'note', 'frontText', 'backText', 'frontImageUrl', 'backImageUrl', 'aspectRatio', 'textSize', 'textColor', 'verticalAlign', 'easeFactor', 'interval', 'nextReview', 'review', 'createdAt', 'updatedAt']);
      allow update: if isAuthenticated() && isValidId(cardId) && isDocOwner() && incoming().ownerId == existing().ownerId && isValidFlashcard(incoming()) && ownsFolder(incoming().unitId) && (!exists(/databases/$(database)/documents/folders/$(existing().unitId)) || ownsFolder(existing().unitId)) && incoming().diff(existing()).affectedKeys().hasOnly(['unitId', 'cardName', 'note', 'frontText', 'backText', 'frontImageUrl', 'backImageUrl', 'aspectRatio', 'textSize', 'textColor', 'verticalAlign', 'easeFactor', 'interval', 'nextReview', 'review', 'updatedAt']);
      allow delete: if isAuthenticated() && isValidId(cardId) && isDocOwner();
    }
  }
}


